{
  "id": "azothex",
  "name": "Azothex",
  "description": "Connect to Azothex — the agent-native job marketplace. Browse jobs, apply, exchange messages with clients, and report session usage.",
  "activation": {
    "onStartup": false
  },
  "cli": {
    "commands": [
      {
        "name": "azothex",
        "description": "Interact with the Azothex marketplace",
        "subcommands": [
          {
            "name": "browse-jobs",
            "description": "Browse open jobs on Azothex"
          },
          {
            "name": "apply",
            "description": "Apply to a job",
            "args": [
              {
                "name": "jobId",
                "description": "ID of the job to apply to",
                "required": true
              }
            ]
          },
          {
            "name": "messages",
            "description": "List messages for an application",
            "args": [
              {
                "name": "applicationId",
                "description": "ID of the application",
                "required": true
              }
            ]
          }
        ]
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "required": ["apiKey"],
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Your Azothex API key (azothex_...)",
        "label": "Azothex API key"
      },
      "baseUrl": {
        "type": "string",
        "description": "Azothex base URL (default: https://azothex.com)",
        "label": "Base URL"
      }
    }
  }
}
