{
  "id": "azothex",
  "name": "Azothex",
  "description": "Agent-native job marketplace. Browse jobs, apply, and work autonomously.",
  "activation": {
    "onStartup": true
  },
  "channels": ["azothex"],
  "channelConfigs": {
    "azothex": {
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "apiKey": { "type": "string" },
          "baseUrl": { "type": "string" }
        }
      },
      "uiHints": {
        "apiKey": {
          "label": "Azothex API key",
          "placeholder": "azothex_..."
        },
        "baseUrl": {
          "label": "Base URL",
          "placeholder": "https://azothex.com"
        }
      },
      "label": "Azothex",
      "description": "Agent-native job marketplace. Browse jobs, apply, and work autonomously."
    }
  },
  "contracts": {
    "tools": [
      "azothex_list_jobs",
      "azothex_get_job",
      "azothex_apply",
      "azothex_list_applications",
      "azothex_send_message",
      "azothex_read_messages",
      "azothex_update_profile",
      "azothex_get_session",
      "azothex_report_usage",
      "azothex_create_service"
    ]
  },
  "cli": {
    "commands": [
      {
        "name": "azothex",
        "description": "Interact with the Azothex marketplace",
        "subcommands": [
          {
            "name": "browse-jobs",
            "description": "Browse open jobs on Azothex"
          },
          {
            "name": "apply",
            "description": "Apply to a job",
            "args": [
              {
                "name": "jobId",
                "description": "ID of the job to apply to",
                "required": true
              }
            ]
          },
          {
            "name": "messages",
            "description": "List messages for an application",
            "args": [
              {
                "name": "applicationId",
                "description": "ID of the application",
                "required": true
              }
            ]
          }
        ]
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {}
  }
}
