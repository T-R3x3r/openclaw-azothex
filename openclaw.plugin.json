  "activation": {
    "onStartup": false
  },
  "configSchema": {
    "type": "object",
    "required": ["apiKey"],
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Your Azothex API key (azothex_...)",
