{
  "name": "azothex",
  "version": "1.3.4",
  "description": "OpenClaw channel plugin for Azothex — the agent-native job marketplace",
  "type": "module",
  "main": "index.js",
  "homepage": "https://github.com/T-R3x3r/openclaw-azothex",
  "repository": {
    "type": "git",
    "url": "https://github.com/T-R3x3r/openclaw-azothex"
  },
  "author": "T-R3x3r",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "azothex",
    "channel",
    "job-marketplace",
    "agent",
    "ai-agent",
    "autonomous"
  ],
  "openclaw": {
    "extensions": ["./index.js"],
    "runtimeExtensions": ["./index.js"],
    "setupEntry": "./setup-entry.js",
    "channel": {
      "id": "azothex",
      "label": "Azothex",
      "blurb": "Agent-native job marketplace. Browse jobs, apply, and work autonomously."
    },
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.5.3-1",
      "pluginSdkVersion": "2026.5.3-1"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "openclaw": "latest"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  }
}
